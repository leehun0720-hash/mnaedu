# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# Confidential business planning material — keep out of the public repo
/docs/

# TEN AI 홈페이지 빌더 — 별도 앱이라 자기 설치본과 빌드물을 따로 가진다
/tenai-builder/node_modules/
/tenai-builder/.next/
/tenai-builder/out/

# 바깥에서 받은 스킬 (npx skills add). 이 저장소는 공개이므로 남의 저작물을
# 여기에 얹지 않는다. 작업하는 컴퓨터에서는 그대로 쓰이고, 다른 컴퓨터에서는
# 같은 명령을 한 번 더 실행하면 된다.
/.agents/
/.claude/skills/
/skills-lock.json
